{
  "name": "grid-layout-plus",
  "version": "2.0.0-beta.0.dolusoft.1",
  "type": "module",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "license": "MIT",
  "author": "qmhc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmhc/grid-layout-plus.git"
  },
  "scripts": {
    "benchmark": "node --expose-gc --import tsx scripts/benchmark.ts",
    "build": "node --import tsx scripts/build.ts",
    "build:docs": "pnpm -C docs build",
    "changeset": "changeset",
    "check:docs": "node --import tsx docs/.vitepress/check-docs.ts",
    "dev": "pnpm -C dev-server serve",
    "dev:docs": "pnpm -C docs serve",
    "lint": "eslint --cache --config eslint.config.ts \"**/*.{js,cjs,mjs,ts,tsx,vue}\"",
    "lint:style": "stylelint --config stylelint.config.ts --cache \"**/*.{vue,scss}\"",
    "precommit": "lint-staged -c ./.husky/.lintstagedrc -q",
    "prepare": "husky",
    "prepublishOnly": "pinst --disable",
    "prettier": "prettier --config prettier.config.ts --write \"{src,dev-server,docs}/**/*.{ts,js,json,css,pcss,scss,vue,html,md}\"",
    "prettier:scripts": "prettier --config prettier.config.ts --write \"scripts/**/*.{ts,js,json}\"",
    "postpublish": "pinst --enable",
    "release": "pnpm run build && changeset publish",
    "release:dolusoft": "node --import tsx scripts/dolusoft-release.ts",
    "test": "vitest run",
    "test:cover": "vitest run --coverage",
    "test:dev": "vitest dev",
    "test:e2e": "playwright test",
    "test:release-markers": "node --import tsx scripts/check-release-tests.ts",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "version-packages": "changeset version"
  },
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./es/core.mjs",
      "require": "./lib/core.cjs"
    },
    "./style.css": "./dist/style.css",
    "./es": {
      "types": "./dist/index.d.ts",
      "import": "./es/index.mjs"
    },
    "./lib": {
      "types": "./dist/index.d.ts",
      "require": "./lib/index.cjs"
    },
    "./es/*.mjs": {
      "types": "./dist/*.d.ts",
      "import": "./es/*.mjs"
    },
    "./es/*": {
      "types": [
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "import": "./es/*.mjs"
    },
    "./lib/*.cjs": {
      "types": "./dist/*.d.ts",
      "require": "./lib/*.cjs"
    },
    "./lib/*": {
      "types": [
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "require": "./lib/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "es",
    "lib",
    "src",
    "CHANGELOG.md",
    "types.d.ts"
  ],
  "keywords": [
    "flex",
    "components",
    "vue",
    "vexip",
    "plugin",
    "toolkit",
    "vite",
    "layout",
    "grid-layout",
    "vue-grid-layout"
  ],
  "dependencies": {
    "@vexip-ui/hooks": "^2.9.4",
    "@vexip-ui/utils": "catalog:",
    "interactjs": "^1.10.28"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@interactjs/types": "^1.10.28",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vexip-ui/commitlint-config": "^0.5.0",
    "@vexip-ui/eslint-config": "^1.3.0",
    "@vexip-ui/prettier-config": "^1.1.0",
    "@vexip-ui/stylelint-config": "^1.1.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "5.0.2",
    "@vue/language-core": "^3.3.11",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "execa": "^10.0.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "kolorist": "^1.8.0",
    "lint-staged": "^17.6.0",
    "pinst": "^3.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-prettier": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
